# Required to create the first local administrator. Choose a password with at least 12 characters.
ADO_BOOTSTRAP_EMAIL=
ADO_BOOTSTRAP_PASSWORD=

# Database passwords. Staging requires a separate API password of at least 12 characters.
POSTGRES_PASSWORD=
ADO_DATABASE_PASSWORD=

# Optional OpenAI Responses credentials and model for planning Agents.
ADO_AGENT_API_KEY=
ADO_AGENT_MODEL=
ADO_API_HTTPS_PROXY=

# GitHub App credentials. Use the App ID and a quoted PEM with escaped \n.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Set to true when serving the Web console over HTTPS.
ADO_SECURE_COOKIES=false
