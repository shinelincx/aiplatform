# Required to create the first local administrator. Choose a password with at least 12 characters.
ADO_BOOTSTRAP_EMAIL=
ADO_BOOTSTRAP_PASSWORD=

# GitHub App credentials. Use the App ID and a quoted PEM with escaped \n.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Set to true when serving the Web console over HTTPS.
ADO_SECURE_COOKIES=false
